---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { id: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { title, description, author, pubDate, updatedDate, heroImage } = post.data;
const { Content } = await render(post);

---

<Page title={title} description={description} image={heroImage} type="article" bodyClass="page post">

  <h1 class="page-name">{title}</h1>

  <div class="page-intro">
    <p class="lead">
       {description}
    </p>
  </div>

  <article class="page-content">
    <Content />
    <hr>
    <p><small class="text-demphasise"><i>Written by {author} and published on <FormattedDate date={pubDate} />{updatedDate && <> (updated on <FormattedDate date={updatedDate} />)</>}</i>.
      <button type="button" title="Copy link to clipboard" data-share-link class="share-button">Share this post</button> with someone or <a href="/blog">read more</a>.</small></p>
  </article>

</Page>

<style>
  .share-button {
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    font: inherit;
    padding: 0;
    text-decoration: underline;
  }
</style>

<script>
  const shareLink = document.querySelector('[data-share-link]');

  if (shareLink) {
    const originalLabel = shareLink.textContent;

    shareLink.addEventListener('click', async () => {
      const url = window.location.href;
      let clipboardWriteSucceeded = false;

      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(url);
          clipboardWriteSucceeded = true;
        } catch {
          clipboardWriteSucceeded = false;
        }
      }

      if (!clipboardWriteSucceeded) {
        // Fallback: show a prompt so the user can manually copy.
        window.prompt('Copy this link:', url);
        return;
      }

      shareLink.textContent = '[Thanks for sharing]';
      window.setTimeout(() => {
        shareLink.textContent = originalLabel;
      }, 2000);
    });
  }
</script>
